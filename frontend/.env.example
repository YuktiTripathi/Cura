VITE_CURA_API_URL=

# Development only. Production uses the SuperShyft bearer token.
VITE_CURA_USER_ID=demo-user-001

# Optional local integration override. Prefer setting supershyft_access_token
# in the host application's localStorage at runtime.
VITE_CURA_ACCESS_TOKEN=

# Optional: show raw LLM JSON in the UI. Never enable in production.
# VITE_CURA_DEBUG=true
