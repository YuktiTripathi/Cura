VITE_CURA_API_URL=

# Development only. Leave empty so the backend MOCK_USER_ID is the identity
# (recommended for local SuperShyft user 2). Set only if the backend has
# ALLOW_MOCK_HEADER_OVERRIDE=true and you need a different mock user.
# Production builds never send this header.
VITE_CURA_USER_ID=

# Optional local integration override. Prefer setting supershyft_access_token
# in the host application's localStorage at runtime.
VITE_CURA_ACCESS_TOKEN=

# Optional: show raw LLM JSON in the UI. Never enable in production.
# VITE_CURA_DEBUG=true

# SuperShyft package detail page. CURA never invents booking URLs in the model.
# VITE_SUPERSHYFT_APP_URL=https://app.supershyft.example
# VITE_SUPERSHYFT_PACKAGE_PATH=/diagnostics/packages/{id}
# VITE_SUPERSHYFT_TEST_GROUP_PATH=/diagnostics/test-groups/{id}
