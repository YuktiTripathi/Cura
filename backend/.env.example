# Cura conversation/audit database (SQLite). Never point this at SuperShyft.
DATABASE_URL=sqlite:///./cura.db

# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY
# Mock auth as SuperShyft user 2, without JWT. Never use this in production.
# APP_ENV=production + AUTH_PROVIDER=mock + HEALTH_PROVIDER=supershyft always
# fails startup, even if ALLOW_MOCK_AUTH_WITH_REAL_HEALTH=true.
# ---------------------------------------------------------------------------
APP_ENV=development
AUTH_PROVIDER=mock
HEALTH_PROVIDER=supershyft
ALLOW_MOCK_AUTH_WITH_REAL_HEALTH=true
MOCK_USER_ID=2
DEV_AUTH_HEADER=true
# Optional. When true, X-Cura-User-Id may override MOCK_USER_ID in development.
ALLOW_MOCK_HEADER_OVERRIDE=false

# Production: AUTH_PROVIDER=supershyft_jwt and HEALTH_PROVIDER=supershyft.
# Do not set MOCK_USER_ID or ALLOW_MOCK_AUTH_WITH_REAL_HEALTH in production.
AUTH_JWT_SECRET=
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_SUBJECT_CLAIM=sub

# OpenRouter (Jev routing + medical LLM). No local Qwen/Ollama fallback.
ENABLE_LLM=false
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DATA_COLLECTION_DENY=true
# data_collection=deny is not proof of zero retention.
# Set OPENROUTER_ZERO_DATA_RETENTION=true only after confirming the OpenRouter
# ZDR-eligible endpoint/providers you will use. CURA cannot independently verify
# retention. For production personal-health LLM, also set:
# REQUIRE_ZDR_FOR_PERSONAL_HEALTH=true
OPENROUTER_ZERO_DATA_RETENTION=false
REQUIRE_ZDR_FOR_PERSONAL_HEALTH=false
CURA_OPENROUTER_REQUIRE_ZDR=false
CURA_OPENROUTER_DENY_DATA_COLLECTION=true
# Personal-health prompts may go only to these models. Safety data retention is
# confirmed on OpenRouter for each one; keep this list in step with the model
# settings below (answer tiers, Jev, safety classifier, translation).
PERSONAL_HEALTH_PRIVACY_PROFILE=safety_retention
PERSONAL_HEALTH_APPROVED_MODELS=google/gemini-3.8-flash,openai/gpt-5-mini,openai/gpt-5.6-luna,typesafe/jev-1.13
CURA_OPENROUTER_ALLOWED_PROVIDERS=openai,google,anthropic,typesafe
CURA_OPENROUTER_ALLOWED_MODELS=
CURA_OPENROUTER_PROMPT_INJECTION_PROTECTION=true
CURA_OPENROUTER_DLP_ENABLED=true
CURA_CLINICAL_SAFETY_ENABLED=true
CURA_PACKAGE_SAFETY_ENABLED=true
ASSISTANT_QUALITY_V2=true
LLM_JSON_SCHEMA_OUTPUT=true
EVAL_CANDIDATE_MODEL=google/gemini-3.8-flash
LLM_ALLOWED_PROVIDERS=openrouter
LLM_ALLOWED_MODELS=openai/gpt-5.6-luna,google/gemini-3.8-flash,openai/gpt-4o-mini,typesafe/jev-1.13
REQUEST_TIMEOUT_SECONDS=60
CHAT_STREAMING_MODE=complete_only
CRISIS_HELPLINE_TEXT=
CRISIS_HELPLINE_REGION=
DOCUMENT_ENCRYPTION_KEY=
DOCUMENT_RETENTION_DAYS=90
# Disabled by default. Set only after an approved operational retention policy.
PROCESSING_JOB_RETENTION_DAYS=0
AUDIT_RECORD_RETENTION_DAYS=0
SUPERSHYFT_POOL_SIZE=5
SUPERSHYFT_MAX_OVERFLOW=2
JEV_ENABLED=true
JEV_MODEL=typesafe/jev-1.13
JEV_TIMEOUT_SECONDS=10
MEDICAL_LLM_MODEL=google/gemini-3.8-flash
# Answer-model tiers (app/routing/model_tier.py chooses the tier per turn).
# The older ANSWER_MODEL_FAST_REASONING / _STANDARD_MEDICAL / _DEEP_MEDICAL names also work.
CURA_FAST_MODEL=google/gemini-3.8-flash
CURA_STANDARD_MODEL=openai/gpt-5-mini
CURA_DEEP_MODEL=openai/gpt-5.6-luna
# Per-tier answer-call caps in seconds, always within the request budget.
ANSWER_TIMEOUT_FAST_SECONDS=10
ANSWER_TIMEOUT_STANDARD_SECONDS=18
ANSWER_TIMEOUT_DEEP_SECONDS=25
# Development only (ignored in production). Leave empty / false.
CURA_FORCE_ANSWER_TIER=
CURA_MODEL_ROUTING_DEBUG=false
# Dump every answer-model request (components, chars, tokens) to CURA_PROMPT_DEBUG_DIR.
# Contains health values: local development only; ignored in production.
CURA_PROMPT_DEBUG=false
CURA_PROMPT_DEBUG_DIR=.prompt_debug
ANSWER_MODEL_NANO=openai/gpt-5.6-luna
ANSWER_MODEL_STANDARD=google/gemini-3.8-flash
ANSWER_MODEL_ADVANCED=google/gemini-3.8-flash
# USD per 1M tokens (placeholders: set your contracted prices). Cost estimates only, never routing.
MODEL_PRICE_FAST_REASONING_INPUT_PER_1M=0.10
MODEL_PRICE_FAST_REASONING_OUTPUT_PER_1M=0.40
MODEL_PRICE_STANDARD_MEDICAL_INPUT_PER_1M=0.25
MODEL_PRICE_STANDARD_MEDICAL_OUTPUT_PER_1M=2.00
MODEL_PRICE_DEEP_MEDICAL_INPUT_PER_1M=1.25
MODEL_PRICE_DEEP_MEDICAL_OUTPUT_PER_1M=10.00
MODEL_PRICE_NANO_INPUT_PER_1M=0.25
MODEL_PRICE_NANO_OUTPUT_PER_1M=2.00
MODEL_PRICE_STANDARD_INPUT_PER_1M=0.75
MODEL_PRICE_STANDARD_OUTPUT_PER_1M=3.75
MODEL_PRICE_ADVANCED_INPUT_PER_1M=3.00
MODEL_PRICE_ADVANCED_OUTPUT_PER_1M=15.00
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=800

# SuperShyft read-only Postgres. Cura never writes to this database.
# postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
SUPERSHYFT_DATABASE_URL=

LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Short-term memory, rate limiting, and idempotency.
# Production should set REDIS_REQUIRED=true.
REDIS_URL=
REDIS_REQUIRED=false
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
IDEMPOTENCY_TTL_SECONDS=300

# Voice / STT. Browser records locally; server transcribes with gpt-transcribe. Audio is discarded after transcription.
VOICE_ENABLED=true
# none | openrouter | local | openai_compatible
STT_PROVIDER=openrouter
STT_API_KEY=
STT_BASE_URL=
STT_MODEL=gpt-transcribe
STT_TIMEOUT_SECONDS=60
STT_MAX_AUDIO_BYTES=10000000

# User-uploaded medical PDFs. Files are extracted, normalized, chunked, and
# retrieved as untrusted user-owned evidence.
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_PATH=./data/uploads
DOCUMENT_MAX_UPLOAD_BYTES=20000000
DOCUMENT_OCR_PROVIDER=none
DOCUMENT_MIN_TEXT_CHARS=80
DOCUMENT_SPARSE_PAGE_CHARS=40
DOCUMENT_MAX_PAGES=50
DOCUMENT_MAX_OCR_PAGES=20
DOCUMENT_MAX_EXTRACTED_CHARS=200000
DOCUMENT_CHUNK_SIZE=900
DOCUMENT_CHUNK_OVERLAP=100
DOCUMENT_RETRIEVE_LIMIT=5

# ---------------------------------------------------------------------------
# Production readiness (see docs/production_readiness.md)
# ---------------------------------------------------------------------------
# APP_ENV=production refuses to start with empty or placeholder secrets, with ZDR
# off while ENABLE_LLM=true, or with a dev SuperShyft URL. Load real values from a
# secret manager; never commit them.
# India numbers in emergency and self-harm replies. Confirm with the clinical owner.
EMERGENCY_NUMBER=112
CRISIS_HELPLINE_NUMBER=14416
# Model-backed safety classifier (runs only when ENABLE_LLM=true).
SAFETY_LLM_CLASSIFIER_ENABLED=true
SAFETY_CLASSIFIER_MODEL=openai/gpt-5.6-luna
SAFETY_CLASSIFIER_TIMEOUT_SECONDS=3
# Consent and public meta default to on outside development.
CONSENT_VERSION=2026-10-v1
# CONSENT_REQUIRED=true
# PUBLIC_META_ONLY=true
SUPERSHYFT_STATEMENT_TIMEOUT_MS=5000
CONVERSATION_RETENTION_DAYS=365
MEMBER_DAILY_TOKEN_BUDGET=200000
LLM_TIMEOUT_SECONDS=30
# RS256 login tokens: set Supershyft's JWKS URL; AUTH_JWT_SECRET is then unused.
AUTH_JWKS_URL=
AUTH_JWT_ALGORITHMS=RS256
# Operations
METRICS_TOKEN=
MAX_IN_FLIGHT_CHATS=32
WORKER_THREADS=64
# Production: s3 document storage in an India region, Redis required, Postgres DATABASE_URL.
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_REGION=ap-south-1
DOCUMENT_S3_KMS_KEY_ID=
# Serve only reviewed, in-date medical content (defaults to on outside development).
# MEDICAL_REQUIRE_REVIEWED=true
# Answer languages (English pivot + translation, only kept if every number matches).
ANSWER_LANGUAGES=en,hi,hinglish
TRANSLATION_MODEL=openai/gpt-5.6-luna
LLM_REASONING_EFFORT=low
LLM_REASONING_OUTPUT_CAP=1200
# Document extraction: "external" in production (run scripts/document_worker.py), "inline" for local dev.
# DOCUMENT_WORKER_MODE=external
DOCUMENT_JOB_LEASE_SECONDS=600
DOCUMENT_JOB_MAX_ATTEMPTS=3
# Hardening (plan 1.9): per-endpoint and per-IP limits; optional clamd malware scan for uploads.
UPLOAD_RATE_LIMIT=20
UPLOAD_RATE_WINDOW_SECONDS=3600
VOICE_RATE_LIMIT=30
VOICE_RATE_WINDOW_SECONDS=600
IP_RATE_LIMIT=300
IP_RATE_WINDOW_SECONDS=60
TRUST_PROXY_HEADERS=false
DOCUMENT_CLAMAV_HOST=
DOCUMENT_CLAMAV_PORT=3310
# Reuse a model answer for an identical prompt for this long (0 disables); bump the version to clear.
ANSWER_CACHE_TTL_SECONDS=86400
ANSWER_CACHE_VERSION=1
# Reuse a member's Supershyft reads for this long (seconds); 0 disables.
HEALTH_DATA_CACHE_SECONDS=90
# Above this model spend per hour (USD), deep answers try the standard tier first; 0 disables.
SPEND_SPIKE_HOURLY_USD=5
# complete_only (default) or tokens_low_risk: stream model tokens for low-risk general answers.
# CHAT_STREAMING_MODE=tokens_low_risk
# Answer plain definitions from a reviewed passage without a model call.
DETERMINISTIC_DEFINITIONS_ENABLED=true

# Response presentation: "rich" (cards, tables, chips; default) or "plain" (the conversational answer only).
# Plain mode is for judging answer quality without UI components.
CURA_RESPONSE_MODE=rich
