{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "question_key",
    "field_provenance",
    "related_content_keys",
    "related_risk_ids",
    "user_explanation",
    "clinical_limitations",
    "source_ids",
    "review_status"
  ],
  "properties": {
    "related_content_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_risk_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "clinical_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_status": {
      "const": "pending_clinical_review"
    }
  }
}