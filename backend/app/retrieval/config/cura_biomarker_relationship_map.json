{
  "schema_version": "1.0.0",
  "name": "CURA Biomarker Relationship Map",
  "purpose": "Metadata-driven configuration for selecting clinically relevant related biomarkers during health-question evidence retrieval.",
  "usage_notes": [
    "Relationships identify candidate evidence to retrieve; they are not diagnostic rules or causal claims.",
    "Only retrieve a related marker when it is available in the user's health record and relevant to the question intent.",
    "Conditional relationships must only be activated when the stated question context applies.",
    "Never infer, calculate, or fabricate a missing biomarker value.",
    "Preserve the source report's value, unit, reference interval, date, and provenance.",
    "Do not retrieve every marker in a panel for every question; apply intent-sensitive expansion and configured caps.",
    "The supplied inventory is treated as the available marker catalogue. Ferritin is not present in that inventory."
  ],
  "retrieval_policy": {
    "expand_for_intents": [
      "interpretation",
      "possible_causes",
      "relationship",
      "comparison",
      "trend",
      "recommendation"
    ],
    "avoid_expansion_for_intents": [
      "definition",
      "simple_unit_or_abbreviation"
    ],
    "max_additional_markers_default": 6,
    "max_additional_markers_for_cross_system_question": 8,
    "deduplicate_by_canonical_id": true,
    "require_record_availability": true,
    "require_question_relevance": true,
    "preserve_lab_reference_range": true,
    "knowledge_base_reference_ranges_override_lab_range": false
  },
